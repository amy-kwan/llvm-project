## Test that llvm-ar correctly writes z/OS archive symbol attribute bits,
## and that llvm-nm --print-armap reads them back correctly.
##
## The three attribute bits come from GOFF ESD record fields:
##   bit 2 (0x4): 64-bit  - AMODE == ESD_AMODE_64
##   bit 1 (0x2): XPLink  - LinkageType == ESD_LT_XPLink
##   bit 0 (0x1): WSA     - parent ED NameSpaceId == ESD_NS_Parts
##
## Real z/OS clang always sets XPLink (bit 1) and 64-bit AMODE (bit 2) on every
## symbol. WSA (bit 0) is additionally set for writable data section symbols.
## The two realistic attribute values are therefore:
##   0x6 [64-bit + XPLink]       -- exported function or read-only data
##   0x7 [64-bit + XPLink + WSA] -- writable data (BSS/data section)
##
## Each case is tested with a dedicated GOFF object generated by
## generate_goff_object.py, which emits HDR + ED + LD + END records.

# RUN: rm -rf %t.dir && mkdir -p %t.dir

## Generate GOFF objects matching real z/OS clang output.
## Both --xplink and --amode64 are on by default in the generator.
# RUN: %python %S/Inputs/generate_goff_object.py --output %t.dir/func.o --name s_func
# RUN: %python %S/Inputs/generate_goff_object.py --output %t.dir/data.o --name s_data --wsa

## Build a z/OS archive containing both objects.
# RUN: llvm-ar rcD --format=zos %t.dir/test.a %t.dir/func.o %t.dir/data.o

## 1. Check the archive map shows each symbol with the correct inline flags.
# RUN: llvm-nm --print-armap %t.dir/test.a | FileCheck %s --check-prefix=ARMAP

# ARMAP:      Archive map
# ARMAP-NEXT: s_func in func.o (flags: 0x00000006 [64-bit + XPLink])
# ARMAP-NEXT: s_data in data.o (flags: 0x00000007 [64-bit + XPLink + WSA])

## 2. Verify the raw attribute words written into the archive symbol table.
##    The z/OS symtab body layout is:
##      bytes 0-3:    num_syms (big-endian uint32)
##      per symbol:   4-byte member_offset + 4-byte attrs (big-endian)
##      after pairs:  null-terminated EBCDIC symbol names
##    The symtab member comes first in the archive, right after the 8-byte magic.
##    Its header is 60 bytes, so the symtab body starts at offset 68.
# RUN: %python -c " \
# RUN:   import struct; \
# RUN:   d = open(r'%t.dir/test.a', 'rb').read(); \
# RUN:   body = d[68:]; \
# RUN:   n = struct.unpack_from('>I', body)[0]; \
# RUN:   attrs = [struct.unpack_from('>I', body, 4 + i*8 + 4)[0] for i in range(n)]; \
# RUN:   print(' '.join(hex(a) for a in attrs)) \
# RUN: " | FileCheck %s --check-prefix=RAWBYTES

# RAWBYTES: 0x6 0x7

## 3. Smoke-test that basic archive operations still work on a GOFF archive.
##    llvm-ar t should list all member names.
# RUN: llvm-ar t %t.dir/test.a | FileCheck %s --check-prefix=LIST

# LIST:      func.o
# LIST-NEXT: data.o

## 4. Test mixed archive: one GOFF object and one bitcode object together.
##    The bitcode member should produce attrs=0 (no GOFF ESD data available).
# RUN: split-file %s %t.dir
# RUN: %python %S/Inputs/generate_goff_object.py --output %t.dir/func2.o --name s_func2
# RUN: llvm-as %t.dir/mixed.ll -o %t.dir/mixed.bc
# RUN: llvm-ar rcD --format=zos %t.dir/mixed.a %t.dir/func2.o %t.dir/mixed.bc
# RUN: llvm-nm --print-armap %t.dir/mixed.a | FileCheck %s --check-prefix=MIXED

# MIXED:      Archive map
# MIXED-NEXT: s_func2 in func2.o (flags: 0x00000006 [64-bit + XPLink])
# MIXED-NEXT: mixed_sym in mixed.bc (flags: 0x00000000 [none])

#--- mixed.ll
define i32 @mixed_sym() {
entry:
  ret i32 0
}
